---
interface Props {
    url: string
    label: string
}
const { url, label } = Astro.props
const style = Astro.routePattern === url ? 'current' : ''
---
<a href={url} id={style} >{label}</a>
<style>
a {
    text-decoration: none;
    color: #2B2A28;
}

a#current {
    color: #C2593F;;
    text-decoration: underline;
}

</style>
