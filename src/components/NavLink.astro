---
interface Props {
    url: string
    label: string
}
const { url, label } = Astro.props
const style = Astro.routePattern === url ? 'current' : ''
---
<a href={url} id={style} >{label}</a>
<style>
a {
    text-decoration: none;
    color: var(--text)
}

a:hover{
    font-weight: bold;
}

a#current {
    color: var(--accent-color-1);
    text-decoration: underline;
}

</style>
