---
interface Props {
    title: string;
    disableHeader?: boolean;
}

import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
const { title, disableHeader } = Astro.props
---

<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, iniital-scale=1">
        <title>{title}</title>
    </head>

    <body>
        <Navigation />
        {disableHeader ? null : <h2 id='header'>{title}</h2>}
        <slot />
        <Footer />
    </body>
</html>

<style is:global>
    :root {
        margin: 12px auto;
        max-width: 1200px;
        padding: 0 2rem;
        background: #F9F6F0;
        color: #2B2A28;
        --accent-color: #C2593F;
    }
</style>
<style>
    h2#header {
        font-family: system-ui, sans-serif;
    }
</style>
