---
const articles = Object.values(import.meta.glob('./*.md', { eager: true}));
---
<ul>
{
articles.map((article) =>
<li>
    <a href={article.url}>
        {article.frontmatter.title}
    </a>
</li>
)
}
</ul>
<style>
a {
    text-decoration: underline;
    color: var(--accent-color-1);
}

a:hover{
    font-weight: bold;
}

a#current {
    color: var(--accent-color-1);
    text-decoration: underline;
}
</style>
